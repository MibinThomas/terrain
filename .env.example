# ---------------------------------------------------------------------------
# Meta Pixel + Conversions API
# Copy to .env.local for local development, and add the same values to your
# Vercel project (Settings > Environment Variables) for production.
# ---------------------------------------------------------------------------

# Pixel / Dataset ID — Events Manager > Data Sources > (your dataset) > Settings.
# Safe to expose: this is the public Pixel ID used by the browser snippet.
NEXT_PUBLIC_META_PIXEL_ID=

# Conversions API access token — SECRET, server-side only.
# Events Manager > (your dataset) > Settings > Conversions API > Generate access token.
# NEVER put the real token in this file — it is committed to git. Real values
# belong in .env.local (gitignored) and in Vercel's environment variables.
META_CAPI_ACCESS_TOKEN=

# Optional: route events to the Test Events stream instead of live data.
# Events Manager > (your dataset) > Test Events. Leave blank in production.
META_CAPI_TEST_EVENT_CODE=

# Optional: Graph API version used for CAPI calls. Defaults to v26.0.
META_GRAPH_API_VERSION=

# Optional: country code prepended to local phone numbers entered without one,
# so they hash to the same value as their international form. Defaults to 971.
META_DEFAULT_COUNTRY_CODE=
